NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/blockstage
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://localhost:6379

# At least 32 characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins. Empty disables CORS.
CORS_ORIGINS=
# Reverse proxies in front of the app. Railway = 1.
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=false

# Global token bucket per user (or per IP when anonymous).
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1
